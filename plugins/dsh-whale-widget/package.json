{
  "name": "dsh-whale-widget",
  "version": "0.4.2-desktop.2",
  "description": "DSH Web 界面右下角的 DeepSeek 余额小鲸鱼挂件:余额/今日已用/峰谷定价、自定义泡泡点击序列(文本/余额/今日/峰谷/图片/随机语句与并列加权选择)、逐行样式与字体、悬浮快捷编辑、音效与每轮消耗、自定义角色/动图/音效、吸附与翻转自定义",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "balance",
    "widget"
  ],
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.png",
  "files": [
    "lib/client.js",
    "LICENSE",
    "locale/zh.json",
    "locale/en.json",
    "native/WhalePet.csproj",
    "native/Program.cs",
    "native/NuGet.Config",
    "icon.png",
    "assets/Ya2.mp3",
    "assets/Ya1.mp3",
    "assets/whale-widget.js",
    "assets/task-end-a.wav",
    "assets/rua.gif",
    "assets/minecraft-exp-orb.wav",
    "assets/extra-quotes.json",
    "assets/DSniang1.png",
    "assets/DSniang02.png",
    "assets/DSH2.png",
    "assets/desktop.html",
    "assets/D2.mp3",
    "assets/D1.mp3",
    "assets/cost-default.wav",
    "assets/bubble-petpet.gif",
    "assets/bubble-money1.gif",
    "assets/ask-default.wav",
    "assets/approve-default.wav",
    "cordis.patch.yml",
    "lib/index.js",
    "lib/accounting.mjs",
    "lib/desktop-v3.js",
    "lib/verify-desktop.js",
    "lib/index-desktop-v3.js",
    "lib/index-v4.js",
    "lib/desktop-v4.js",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeteorNOX/DeepSeek-Balance-Whale-Widget.git"
  },
  "bugs": {
    "url": "https://github.com/MeteorNOX/DeepSeek-Balance-Whale-Widget/issues"
  },
  "homepage": "https://github.com/MeteorNOX/DeepSeek-Balance-Whale-Widget#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "exports": {
    ".": "./lib/index-v4.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./desktop-runtime-v3": "./lib/index-desktop-v3.js",
    "./desktop-runtime-v3/locale/*.json": "./locale/*.json",
    "./desktop-runtime-v3/icon": "./icon.png",
    "./client": "./lib/client.js"
  },
  "private": true
}
