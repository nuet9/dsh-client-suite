{
  "name": "@local/browser-tabs",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Connects the agent to a running Chromium browser over the DevTools protocol so it can inspect and operate real browser tabs.",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "icon.svg",
    "locale/zh.json",
    "locale/en.json",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-browser-use": "0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-browser-use-chrome-devtools-mcp": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
