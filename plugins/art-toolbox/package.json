{
  "name": "@local/art-toolbox",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "Art production workflows and categorized versioned result repositories",
  "exports": {
    ".": "./index-pinterest-v1-concept.js",
    "./client": "./client-comfy-v1-concept.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "icon.svg",
    "locale/zh.json",
    "locale/en.json",
    "cordis.patch.yml",
    "client-comfy-v1-concept.js",
    "index-pinterest-v1-concept.js",
    "image-input-v1.js",
    "base-v15-concept.js",
    "reference-providers-v1.js",
    "agent-request-v1.js",
    "session-target-v1.js",
    "defaults-v11-concept.js",
    "defaults-v9.js",
    "defaults-v8.js",
    "defaults-v7.js",
    "defaults-v6.js",
    "defaults-v5.js",
    "pinterest-sync-v1-concept.js",
    "pinterest-projects-v1-concept.js",
    "model-selection-v1-concept.js",
    "repository-v11-concept.js",
    "previews-v1.js",
    "workflow-folder-v1.js",
    "folder-target-v1.js",
    "folder-reveal-v1.js",
    "reveal-folder.ps1",
    "browser-login-v2.js",
    "browser-close-v1.ps1",
    "browser-process-v1.ps1",
    "pinterest-queue-v11.js",
    "browser-dispatch-v1.js",
    "child-handoff-v1.js",
    "comfy-library-schema-v1.js",
    "comfy-library-v1.js",
    "comfy-service-v1.js",
    "comfy-process-v1.ps1",
    "pinterest-research-v1.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "sharp": "0.35.5"
  }
}
