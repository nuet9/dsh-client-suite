{
  "name": "@local/claude-throughput-fix",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Correct buffered Claude throughput without changing other model statistics",
  "exports": {
    ".": "./host-v2.js",
    "./host-v2": "./host-v2.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "icon.svg",
    "locale/zh.json",
    "locale/en.json",
    "cordis.patch.yml",
    "client.js",
    "host-v2.js",
    "metrics.js"
  ],
  "dependencies": {
    "zod": "4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
