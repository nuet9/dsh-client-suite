{
  "name": "@local/file-folder-open",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Open explicit folder links in Windows Explorer.",
  "exports": {
    ".": "./client-host.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./host-v3": "./host-v3.js",
    "./host-v3/client": "./client-v3.js",
    "./host-v3/locale/*.json": "./locale/*.json",
    "./host-v3/icon": "./icon.svg"
  },
  "files": [
    "icon.svg",
    "locale/zh.json",
    "locale/en.json",
    "cordis.patch.yml",
    "client-v3.js",
    "host-v3.js",
    "reveal-folder.ps1",
    "client.js",
    "client-host.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
